alized_name":"edited_image","name":"edited_image","type":"IMAGE","link":16},{"localized_name":"badge_mask","name":"badge_mask","type":"MASK","link":20},{"localized_name":"difference_amplification","name":"difference_amplification","type":"FLOAT","widget":{"name":"difference_amplification"},"link":null}],"outputs":[{"localized_name":"passes_design_lock","name":"passes_design_lock","type":"BOOLEAN","links":null},{"localized_name":"qa_report","name":"qa_report","type":"STRING","links":null},{"localized_name":"difference_preview","name":"difference_preview","type":"IMAGE","links":[22]}],"title":"自动验收：设计锁定 QA","properties":{"Node name for S&R":"BadgeFidelityQA"},"widgets_values":[4]},{"id":13,"type":"PreviewImage","pos":[1303.5397547275995,947.9892092581288],"size":[760,330],"flags":{},"order":20,"mode":0,"inputs":[{"localized_name":"图像","name":"images","type":"IMAGE","link":21}],"outputs":[{"localized_name":"images","name":"images","type":"IMAGE","links":null}],"title":"诊断：原图 / 编辑 / 高度 / 法线","properties":{"Node name for S&R":"PreviewImage"},"widgets_values":[]},{"id":14,"type":"PreviewImage","pos":[830,1210],"size":[400,330],"flags":{},"order":23,"mode":0,"inputs":[{"localized_name":"图像","name":"images","type":"IMAGE","link":22}],"outputs":[{"localized_name":"images","name":"images","type":"IMAGE","links":null}],"title":"差异预览（4 倍）","properties":{"Node name for S&R":"PreviewImage"},"widgets_values":[]},{"id":15,"type":"MarkdownNote","pos":[-520,30],"size":[500,400],"flags":{},"order":1,"mode":0,"inputs":[],"outputs":[],"title":"v1 使用方法","properties":{"text":"## v1 使用方法\n\n1. 选择徽章原图。\n2. 在三个颜色选区节点中填写实际颜色，例如 `#D84236`。同一角色可以填写多个颜色，用逗号隔开。\n3. 选区节点只负责生成遮罩：接到 `raised_mask` 就凸起，接到 `recessed_mask` 就下沉。\n4. 先看区域图和高度图，确认结构正确，再调 `relief_amount`。\n5. 如果已有手绘、PSD/SVG 导出或分割遮罩，可以绕过颜色选区节点，直接连接主节点。\n\n当前示例颜色针对 1280X1280.PNG；更换徽章后应先修改三个颜色字段。"},"widgets_values":["## 使用方法\n\n1. 选择徽章原图。\n2. 在三个颜色选区节点中填写实际颜色，例如 `#D84236`。同一角色可以填写多个颜色，用逗号隔开。\n3. 选区节点只负责生成遮罩：接到 `raised_mask` 就凸起，接到 `recessed_mask` 就下沉。\n4. 先看区域图和高度图，确认结构正确，再调 `relief_amount`。\n5. 如果已有手绘、PSD/SVG 导出或分割遮罩，可以绕过颜色选区节点，直接连接主节点。\n\n当前示例颜色针对 1280X1280.PNG；更换徽章后应先修改三个颜色字段。"],"color":"#315a48","bgcolor":"#243f34"},{"id":16,"type":"MarkdownNote","pos":[-520,470],"size":[500,440],"flags":{},"order":2,"mode":0,"inputs":[],"outputs":[],"title":"高度参数","properties":{"text":"## 高度参数\n\n- `raised_height`：凸起遮罩的相对高度。\n- `recessed_depth`：凹陷遮罩的相对深度。\n- `detail_height`：细节遮罩的附加高度，可以为负值。\n- `rim_height`：自动外圈凸缘。\n- `dome_height`：整枚徽章的拱面。\n- `outer_bevel_width`：徽章外边缘坡面宽度。\n- `region_bevel_width`：区域之间的坡面宽度；小字丢失时减小。\n- `relief_amount`：整张高度图的总浮雕强度。\n\n这些都是相对高度，不是毫米值。遮罩重叠时高度会叠加；没有叠层需要时，尽量让三个遮罩互斥。"},"widgets_values":["## 高度参数\n\n- `raised_height`：凸起遮罩的相对高度。\n- `recessed_depth`：凹陷遮罩的相对深度。\n- `detail_height`：细节遮罩的附加高度，可以为负值。\n- `rim_height`：自动外圈凸缘。\n- `dome_height`：整枚徽章的拱面。\n- `outer_bevel_width`：徽章外边缘坡面宽度。\n- `region_bevel_width`：区域之间的坡面宽度；小字丢失时减小。\n- `relief_amount`：整张高度图的总浮雕强度。\n\n这些都是相对高度，不是毫米值。遮罩重叠时高度会叠加；没有叠层需要时，尽量让三个遮罩互斥。"],"color":"#554b2f","bgcolor":"#3d3726"},{"id":17,"type":"MarkdownNote","pos":[-520,950],"size":[500,360],"flags":{},"order":3,"mode":0,"inputs":[],"outputs":[],"title":"颜色选区怎么调","properties":{"text":"## 颜色选区怎么调\n\n- `target_colors`：填写一个或多个 `#RRGGBB`。\n- `tolerance`：完整选中的色差范围。\n- `softness`：范围边缘的柔和过渡。\n\n先把 tolerance 调小，避免选到邻近颜色；再逐步提高，直到覆盖阴影和高光。渐变、纹理或相近颜色很多时，建议改用人工遮罩。\n\n颜色本身不再决定高低：红色既可以接凸起，也可以接凹陷。"},"widgets_values":["## 颜色选区\n\n- `target_colors`：填写一个或多个 `#RRGGBB`。\n- `tolerance`：完整选中的色差范围。\n- `softness`：范围边缘的柔和过渡。\n\n先把 tolerance 调小，避免选到邻近颜色；再逐步提高，直到覆盖阴影和高光。渐变、纹理或相近颜色很多时，建议改用人工遮罩。\n\n颜色本身不再决定高低：红色既可以接凸起，也可以接凹陷。"],"color":"#4a3e5b","bgcolor":"#372f42"},{"id":18,"type":"MarkdownNote","pos":[-503.27202580710946,1403.2744452305915],"size":[470,430],"flags":{},"order":4,"mode":0,"inputs":[],"outputs":[],"title":"原理和边界","properties":{"text":"## 原理和边界\n\n区域遮罩先被转换成带倒角的相对高度场，再生成法线、遮蔽和阴影。最终只在原图相同坐标上调整线性 RGB 明暗，不重绘、不变形、不经过 VAE。\n\n区域预览的颜色含义：\n- 红色：凸起\n- 蓝色：凹陷\n- 绿色：附加细节\n\n它仍然是正视图 2.5D 外观编辑，不能产生真实侧壁、视差或制造用三维曲面。"},"widgets_values":["## 原理和边界\n\n区域遮罩先被转换成带倒角的相对高度场，再生成法线、AO和阴影。最终只在原图相同坐标上调整线性 RGB 明暗\n\n区域预览的颜色含义：\n- 红色：凸起\n- 蓝色：凹陷\n- 绿色：附加细节"],"color":"#4b3a54","bgcolor":"#382d3e"},{"id":19,"type":"OpenAIGPTImageNodeV2","pos":[1271.0517175950017,1390.075849156902],"size":[392.53125,467.328125],"flags":{},"order":22,"mode":0,"inputs":[{"localized_name":"提示词","name":"prompt","type":"STRING","widget":{"name":"prompt"},"link":null},{"localized_name":"模型","name":"model","type":"COMFY_DYNAMICCOMBO_V3","widget":{"name":"model"},"link":null},{"localized_name":"尺寸","name":"model.size","type":"COMBO","widget":{"name":"model.size"},"link":null},{"localized_name":"自定义宽度","name":"model.custom_width","type":"INT","widget":{"name":"model.custom_width"},"link":null},{"localized_name":"自定义高度","name":"model.custom_height","type":"INT","widget":{"name":"model.custom_height"},"link":null},{"localized_name":"背景","name":"model.background","type":"COMBO","widget":{"name":"model.background"},"link":null},{"localized_name":"质量","name":"model.quality","type":"COMBO","widget":{"name":"model.quality"},"link":null},{"label":"image_1","localized_name":"model.images.image_1","name":"model.images.image_1","shape":7,"type":"IMAGE","link":23},{"label":"image_2","localized_name":"model.images.image_2","name":"model.images.image_2","shape":7,"type":"IMAGE","link":24},{"label":"image_3","localized_name":"model.images.image_3","name":"model.images.image_3","shape":7,"type":"IMAGE","link":25},{"label":"image_4","localized_name":"model.images.image_4","name":"model.images.image_4","shape":7,"type":"IMAGE","link":null},{"label":"mask","localized_name":"model.mask","name":"model.mask","shape":7,"type":"MASK","link":null},{"localized_name":"数量","name":"n","type":"INT","widget":{"name":"n"},"link":null},{"localized_name":"种子","name":"seed","type":"INT","widget":{"name":"seed"},"link":null}],"outputs":[{"localized_name":"图像","name":"IMAGE","type":"IMAGE","links":[26]}],"properties":{"Node name for S&R":"OpenAIGPTIm