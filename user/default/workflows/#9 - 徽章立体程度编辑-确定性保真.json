,546.9196295175782],"size":[300,330],"flags":{},"order":9,"mode":0,"inputs":[{"localized_name":"图像","name":"images","type":"IMAGE","link":24}],"outputs":[{"localized_name":"images","name":"images","type":"IMAGE","links":[37,39]}],"title":"法线预览","properties":{"Node name for S&R":"PreviewImage"},"widgets_values":[]},{"id":7,"type":"PreviewImage","pos":[957.5158443969726,1023.8721939007569],"size":[690,330],"flags":{},"order":11,"mode":0,"inputs":[{"localized_name":"图像","name":"images","type":"IMAGE","link":26}],"outputs":[{"localized_name":"images","name":"images","type":"IMAGE","links":null}],"title":"诊断：原图 / 编辑 / 高度 / 法线","properties":{"Node name for S&R":"PreviewImage"},"widgets_values":[]},{"id":8,"type":"BadgeFidelityQA","pos":[456.0536547668456,888.7646451849371],"size":[380,220],"flags":{},"order":10,"mode":0,"inputs":[{"localized_name":"original_image","name":"original_image","type":"IMAGE","link":2},{"localized_name":"edited_image","name":"edited_image","type":"IMAGE","link":22},{"localized_name":"badge_mask","name":"badge_mask","type":"MASK","link":25},{"localized_name":"difference_amplification","name":"difference_amplification","type":"FLOAT","widget":{"name":"difference_amplification"},"link":null}],"outputs":[{"localized_name":"passes_design_lock","name":"passes_design_lock","type":"BOOLEAN","links":null},{"localized_name":"qa_report","name":"qa_report","type":"STRING","links":null},{"localized_name":"difference_preview","name":"difference_preview","type":"IMAGE","links":[10]}],"title":"自动验收：设计锁定 QA","properties":{"Node name for S&R":"BadgeFidelityQA"},"widgets_values":[4]},{"id":9,"type":"PreviewImage","pos":[460.3484791638183,1178.090863482667],"size":[380,350],"flags":{},"order":14,"mode":0,"inputs":[{"localized_name":"图像","name":"images","type":"IMAGE","link":10}],"outputs":[{"localized_name":"images","name":"images","type":"IMAGE","links":null}],"title":"差异预览（4倍，仅亮度应变化）","properties":{"Node name for S&R":"PreviewImage"},"widgets_values":[]},{"id":10,"type":"MarkdownNote","pos":[-543.4900819139094,5.9303135180892355],"size":[522.78125,289.96875],"flags":{},"order":1,"mode":0,"inputs":[],"outputs":[],"title":"使用方法","properties":{"text":"## 使用方法\n\n1. 在左下角的 **输入：徽章平面图** 中选图。\n2. 第一次使用只调 `relief_amount`：`0` 保持原图，`0.5` 较浅，`1.0–1.8` 比较自然，`2.2` 已经很强，`3.0` 主要用于检查上限。\n3. 点击运行，在右侧查看编辑结果、高度图和法线图。\n4. 结果满意后，由 **保存编辑结果** 节点写入 `output/badge_relief/`。\n\n这套流程不生成新图，也不移动文字和图案。它先估算高度，再在原图同一位置调整明暗。"},"widgets_values":["## 使用方法\n\n1. 在左下角的 **输入：徽章平面图** 中选图。\n2. 第一次使用只调 `relief_amount`：`0` 保持原图，`0.5` 较浅，`1.0–1.8` 比较自然，`2.2` 已经很强，`3.0` 主要用于检查上限。\n3. 点击运行，在右侧查看编辑结果、高度图和法线图。\n4. 结果满意后，由 **保存编辑结果** 节点写入 `output/badge_relief/`。\n\n这套流程不生成新图，也不移动文字和图案。它先估算高度，再在原图同一位置调整明暗。"],"color":"#2f566f","bgcolor":"#243c4c"},{"id":11,"type":"MarkdownNote","pos":[-537.333861768235,356.87536050023937],"size":[514,618.375],"flags":{},"order":2,"mode":0,"inputs":[],"outputs":[],"title":"参数说明","properties":{"text":"## 参数怎么调\n\n- `relief_amount`：总浮雕强度，先调这一项。\n- `reference_relief`：输入图已有的参考立体程度。平面设计稿用 `0`；只有在尝试减弱原图已有光照时才提高。\n- `gold_raise`：金色和暖色图案的相对抬升量。\n- `enamel_recess`：蓝色和冷色区域的相对下沉量。\n- `rim_height`：外圈凸缘高度。\n- `dome_height`：徽章整体拱起程度。\n- `bevel_width`：倒角宽度。数值小，边缘更硬；数值大，坡面更宽。\n- `normal_strength`：坡度在光照中的表现强度，不会改变像素位置。\n- `lighting_strength`：明暗变化总强度。\n- `light_azimuth / elevation`：光线方向和高度。\n- `shadow_strength / ao_strength`：投影和凹槽暗部。\n\n`gold_raise`、`enamel_recess` 和 `dome_height` 会共同参与高度图归一化，不是线性的毫米刻度。后半段可能逐渐饱和。\n\n背景复杂时，请把外部前景遮罩接到 `foreground_mask`。自动遮罩主要适合白底或颜色比较均匀的背景。"},"widgets_values":["## 参数说明\n\n- `relief_amount`：总浮雕强度，先调这一项。\n- `reference_relief`：输入图已有的参考立体程度。平面设计稿用 `0`；只有在尝试减弱原图已有光照时才提高。\n- `gold_raise`：金色和暖色图案的相对抬升量。\n- `enamel_recess`：蓝色和冷色区域的相对下沉量。\n- `rim_height`：外圈凸缘高度。\n- `dome_height`：徽章整体拱起程度。\n- `bevel_width`：倒角宽度。数值小，边缘更硬；数值大，坡面更宽。\n- `normal_strength`：坡度在光照中的表现强度，不会改变像素位置。\n- `lighting_strength`：明暗变化总强度。\n- `light_azimuth / elevation`：光线方向和高度。\n- `shadow_strength / ao_strength`：投影和凹槽暗部。\n\n`gold_raise`、`enamel_recess` 和 `dome_height` 会共同参与高度图归一化，不是线性的毫米刻度。后半段可能逐渐饱和。\n\n背景复杂时，请把外部前景遮罩接到 `foreground_mask`。自动遮罩主要适合白底或颜色比较均匀的背景。"],"color":"#3d4d31","bgcolor":"#2d3827"},{"id":12,"type":"MarkdownNote","pos":[954.2946278015136,1419.9773921984863],"size":[690,300],"flags":{},"order":3,"mode":0,"inputs":[],"outputs":[],"title":"输出内容","properties":{"text":"## 怎么看输出\n\n- **编辑结果**：最后使用和保存的图片。\n- **高度图**：白色较高，黑色较低。用它检查金色、蓝色和外圈的高低关系。\n- **法线图**：显示表面朝向。出现很密的彩色条纹，通常说明 `normal_strength` 或浮雕强度过大。\n- **诊断图**：从左到右依次为原图、结果、高度图、法线图。\n- **差异图**：为了便于观察放大了 4 倍。它有内容是正常的，因为浮雕就是通过明暗变化形成的。\n\n`Badge Fidelity QA` 返回通过时，说明尺寸、背景和线性颜色比例符合保真条件。它不判断效果是否自然；这一点仍要看预览。"},"widgets_values":["## 输出内容\n\n- **编辑结果**：最后使用和保存的图片。\n- **高度图**：白色较高，黑色较低。用它检查金色、蓝色和外圈的高低关系。\n- **法线图**：显示表面朝向。出现很密的彩色条纹，通常说明 `normal_strength` 或浮雕强度过大。\n- **诊断图**：从左到右依次为原图、结果、高度图、法线图。\n- **差异图**：为了便于观察放大了 4 倍。它有内容是正常的，因为浮雕就是通过明暗变化形成的。\n\n`Badge Fidelity QA` 返回通过时，说明尺寸、背景和线性颜色比例符合保真条件。它不判断效果是否自然；这一点仍要看预览。"],"color":"#574530","bgcolor":"#403426"},{"id":13,"type":"MarkdownNote","pos":[-534.8383529764806,1032.3690689626667],"size":[509.1875,503.84375],"flags":{},"order":4,"mode":0,"inputs":[],"outputs":[],"title":"处理原理和边界","properties":{"text":"## 处理原理\n\n1. 从画面边缘估计背景，得到徽章轮廓。\n2. 根据外圈距离和颜色分区建立高度图：金色偏高，蓝色珐琅偏低。\n3. 从高度图计算法线、遮蔽、阴影和高光。\n4. 在原图每个像素的原位置，用同一个倍率调整线性 RGB 三个通道。\n\n因此，文字和图案不会被重新生成，也没有缩放、扭曲和 VAE 往返。\n\n## 做不到的事\n\n- 不能生成真实侧壁或改变观察角度。\n- 不能恢复被遮挡的内容。\n- 不能从单张图准确还原真实三维高度。\n- 输入图里已有很强的阴影时，只能近似减弱。\n\n它适合做正视图上的 2.5D 浮雕外观，不替代三维建模。"},"widgets_values":["## 处理原理\n\n1. 从画面边缘估计背景，得到徽章轮廓。\n2. 根据外圈距离和颜色分区建立高度图：金色偏高，蓝色珐琅偏低。\n3. 从高度图计算法线、遮蔽、阴影和高光。\n4. 在原图每个像素的原位置，用同一个倍率调整线性 RGB 三个通道。\n\n因此，文字和图案不会被重新生成，也没有缩放、扭曲和 VAE 往返。\n\n## 做不到的事\n\n- 不能生成真实侧壁或改变观察角度。\n- 不能恢复被遮挡的内容。\n- 不能从单张图准确还原真实三维高度。\n- 输入图里已有很强的阴影时，只能近似减弱。\n\n它适合做正视图上的 2.5D 浮雕外观，不替代三维建模。"],"color":"#4d3b54","bgcolor":"#372d3c"},{"id":15,"type":"BadgeReliefEditor","pos":[450.6209383877841,64.78525612571036],"size":[380,650],"flags":{},"order":5,"mode":0,"inputs":[{"localized_name":"image","name":"image","type":"IMAGE","link":19